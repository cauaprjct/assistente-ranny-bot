# ============================================
# ASSISTENTE RANNY - CONFIGURAÇÃO DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com suas credenciais
# NUNCA commite o arquivo .env no Git!

# ============ TELEGRAM (OBRIGATÓRIO) ============
TELEGRAM_BOT_TOKEN=seu_token_do_botfather_aqui
GROUP_ID=-1003536252896

# ============ GEMINI AI (OBRIGATÓRIO) ============
GEMINI_API_KEY=sua_chave_gemini_aqui

# ============ MICROSOFT OAUTH2 (OPCIONAL - OneDrive) ============
# Para usar integração com OneDrive, configure no Azure Portal:
# https://portal.azure.com → Azure Active Directory → App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://assistente-ranny.onrender.com/oauth/callback
ONEDRIVE_SYNC_FOLDER=

# ============ SUPABASE (OPCIONAL - Banco de dados na nuvem) ============
# Se não configurar, o bot usará SQLite local
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ============ TÓPICOS DO TELEGRAM ============
# IDs dos tópicos do grupo (configure após criar os tópicos)
TOPIC_CHAT=47
TOPIC_FINANCEIRO=2
TOPIC_EMPRESA=3
TOPIC_JURIDICO=5
TOPIC_PESSOAL=4
TOPIC_FUNCIONARIOS=6
TOPIC_MANUTENCAO=7
TOPIC_OUTROS=8
TOPIC_OPERACIONAL=214
TOPIC_MIDIA=215
TOPIC_CONTROLES=216

# ============ DEPLOY (OPCIONAL) ============
# Railway define automaticamente
RAILWAY_ENVIRONMENT=development
RAILWAY_PUBLIC_DOMAIN=

# Render define automaticamente
RENDER_EXTERNAL_URL=

# URL base para links (opcional - será detectada automaticamente se não definida)
BASE_URL=

# ============ INSTRUÇÕES ============
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o .env com suas credenciais
# 3. NUNCA commite o .env no Git!
# 4. Para obter token do Telegram: https://t.me/BotFather
# 5. Para obter chave Gemini: https://makersuite.google.com/app/apikey

# Configurações do Bot Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Configurações do Gemini AI
GEMINI_API_KEY=sua_chave_aqui

# ID do grupo
GROUP_ID=-1003536252896

# IDs dos tópicos do grupo
TOPIC_CHAT=47
TOPIC_FINANCEIRO=2
TOPIC_EMPRESA=3
TOPIC_JURIDICO=5
TOPIC_PESSOAL=4
TOPIC_FUNCIONARIOS=6
TOPIC_MANUTENCAO=7
TOPIC_OUTROS=8
TOPIC_OPERACIONAL=214
TOPIC_MIDIA=215
TOPIC_CONTROLES=216

# Microsoft OAuth2 (OneDrive integration - opcional)
# Registre um app em https://portal.azure.com > Azure Active Directory > App registrations
MICROSOFT_CLIENT_ID=seu_client_id_aqui
MICROSOFT_CLIENT_SECRET=seu_client_secret_aqui
MICROSOFT_REDIRECT_URI=http://localhost:8000/oauth/callback

# OneDrive - Pasta sincronizada do notebook (opcional)
# Deixe vazio para buscar em todo o OneDrive
# Exemplo: Documentos/GRN Pizzas
ONEDRIVE_SYNC_FOLDER=

# Servidor Web
# Railway define PORT automaticamente em produção
PORT=8000

# URL base para links de relatórios
# Em produção no Railway, há 3 opções (em ordem de prioridade):
# 1. BASE_URL - defina manualmente se tiver domínio customizado
# 2. RAILWAY_PUBLIC_DOMAIN - Railway define automaticamente (ex: seu-app.up.railway.app)
# 3. localhost:PORT - fallback para desenvolvimento local
#
# Para domínio customizado no Railway:
# 1. Vá em Settings > Domains no painel do Railway
# 2. Adicione seu domínio customizado (ex: ranny.seudominio.com)
# 3. Configure o DNS apontando para o Railway
# 4. Defina BASE_URL=https://ranny.seudominio.com
BASE_URL=

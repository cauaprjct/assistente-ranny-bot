# ============================================
# Variáveis de Ambiente para Railway
# ============================================
# Configure estas variáveis no painel do Railway:
# https://railway.app > Seu Projeto > Variables
# ============================================

# ============ OBRIGATÓRIAS ============

# Bot Telegram
TELEGRAM_BOT_TOKEN=seu_token_do_botfather

# Gemini AI (Google)
GEMINI_API_KEY=sua_chave_gemini

# Supabase (Banco de Dados)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key
SUPABASE_SERVICE_KEY=sua_service_key

# ID do Grupo Telegram
GROUP_ID=-1003536252896

# ============ TÓPICOS DO GRUPO ============
# IDs dos tópicos no grupo do Telegram

TOPIC_CHAT=47
TOPIC_FINANCEIRO=2
TOPIC_EMPRESA=3
TOPIC_JURIDICO=5
TOPIC_PESSOAL=4
TOPIC_FUNCIONARIOS=6
TOPIC_MANUTENCAO=7
TOPIC_OUTROS=8

# ============ SERVIDOR WEB ============
# Railway define PORT automaticamente, mas pode sobrescrever

# PORT=8000

# URL base para links de relatórios
# Railway fornece automaticamente via RAILWAY_PUBLIC_DOMAIN
# O sistema usa a seguinte prioridade:
# 1. BASE_URL (se definido) - use para domínio customizado
# 2. RAILWAY_PUBLIC_DOMAIN (automático do Railway)
# 3. localhost:PORT (fallback)
#
# Para domínio customizado:
# 1. Vá em Settings > Domains no painel do Railway
# 2. Adicione seu domínio (ex: ranny.seudominio.com)
# 3. Configure DNS CNAME apontando para Railway
# 4. Defina BASE_URL abaixo
BASE_URL=https://seu-app.up.railway.app

# ============ ONEDRIVE (OPCIONAL) ============
# Integração com Microsoft OneDrive

MICROSOFT_CLIENT_ID=seu_client_id_azure
MICROSOFT_CLIENT_SECRET=seu_client_secret_azure
MICROSOFT_REDIRECT_URI=https://seu-app.up.railway.app/oauth/callback

# Pasta sincronizada do notebook (deixe vazio para todo OneDrive)
ONEDRIVE_SYNC_FOLDER=

# ============ NOTAS ============
# 
# 1. Crie o bot no @BotFather do Telegram
# 2. Crie projeto no Supabase e execute o schema SQL
# 3. Obtenha chave Gemini em https://makersuite.google.com/app/apikey
# 4. Para OneDrive, registre app em https://portal.azure.com
# 5. Railway define automaticamente:
#    - PORT (porta do servidor)
#    - RAILWAY_PUBLIC_DOMAIN (domínio público)
#    - RAILWAY_ENVIRONMENT (production/staging)
